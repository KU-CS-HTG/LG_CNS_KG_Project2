# 복사해서 .env로 만들고 값을 채운다. .env는 커밋하지 않는다.
GOV24_API_KEY=            # 공공데이터포털 일반 인증키(Decoding)
OPENAI_API_KEY=           # 생성(gpt-4o-mini) 및 조건 추출용
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu     # 비우면 자동(cuda > mps > cpu). 메모리가 부족하면 cpu로 고정
# HF_TOKEN=                 # 선택. Hugging Face 토큰(Read 권한). 설정하면 "unauthenticated requests" 경고가 사라지고 다운로드가 빨라진다
# HF_HUB_OFFLINE=1          # 선택. 모델을 이미 내려받은 뒤에는 네트워크 확인 없이 캐시만 쓴다 (경고 없음, 시작이 빠름). 새 모델을 받을 때는 지운다

