# 로컬 개발용 공개 예제 값. 실제 비밀번호와 인증키는 .env에서만 설정.
POSTGRES_USER=benefits
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=benefits
DATABASE_URL=postgresql+psycopg://benefits:local-dev-only@127.0.0.1:55432/benefits
# 공공데이터포털 활용신청 승인 후 Decoding 인증키 입력. 비어 있으면 live 실행 불가.
GOV24_SERVICE_KEY=
# 아래 항목은 향후 생성 단계용이며 이번 수집 코드는 사용하지 않음.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GENERATION_MODEL=gpt-4o-mini
